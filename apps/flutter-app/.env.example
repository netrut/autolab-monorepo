# Flutter App Environment Variables
# Copy this file to .env and update values

# API URL - Backend server
# Development (Android emulator): http://10.0.2.2:3000
# Development (physical device):  http://192.168.x.x:3000
# Development (web/codespace):    http://localhost:3000
# Production:                     https://your-api.vercel.app
API_URL=http://localhost:3000

# Web port (for flutter run -d chrome)
WEB_PORT=8080
